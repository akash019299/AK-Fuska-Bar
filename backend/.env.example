PORT=3000
# Exact production GitHub Pages origin, e.g. https://akash019299.github.io
ALLOWED_ORIGIN=https://akash019299.github.io
# Firebase project ID and private service account JSON. Never commit real credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Firebase Storage bucket, e.g. your-firebase-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Set a long random secret (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
# Generate this with: npm run hash-password -- 'your-long-password'
ADMIN_PASSWORD_HASH=
